---
import I18nKey from "../../../i18n/i18nKey";
import { i18n } from "../../../i18n/translation";

const pageViewsText = i18n(I18nKey.profileStatsPageViews);
const visitsText = i18n(I18nKey.profileStatsVisits);
---

<script is:inline define:vars={{ pageViewsText, visitsText }}>
	function generateStatsText(pageViews, visits) {
		return `${pageViewsText} ${pageViews} · ${visitsText} ${visits}`;
	}

	async function fetchPageViews() {
		const container = document.querySelector(".umami-page-views");

		if (!window.oddmisc) {
			container?.classList.add("hidden");
			return;
		}

		const id = container?.dataset.id;
		if (!id) {
			return;
		}

		try {
			const stats = await window.oddmisc.getStats(`/posts/${id}/`);
			const pageViews = stats.pageviews || 0;
			const visits = stats.visits || 0;

			if (pageViews === 0 && visits === 0) {
				container.classList.add("hidden");
				return;
			}

			container.classList.remove("hidden");
			const display = container.querySelector(".page-views-display");
			if (display) {
				display.textContent = generateStatsText(pageViews, visits);
			}
		} catch (error) {
			console.error("Error fetching page views:", error);
			container.classList.add("hidden");
		}
	}

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", fetchPageViews);
	} else {
		fetchPageViews();
	}
</script>
